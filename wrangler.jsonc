{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-portfolio",
  "compatibility_date": "2026-09-29",
  // Build before every `wrangler deploy`, so dist/ exists even if the
  // Cloudflare dashboard has no build command configured.
  "build": {
    "command": "npm run build"
  },
  "main": "worker/index.js",
  // Serves the prerendered Vite build from dist/. The Worker script only runs
  // for the paths in run_worker_first (search-engine verification files).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/google141e7734458b5ef6.html"]
  }
}
