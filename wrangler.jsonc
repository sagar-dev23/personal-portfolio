{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagr-work",
  "compatibility_date": "2026-09-29",
  // Static-only Worker: serves the prerendered Vite build from dist/.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
